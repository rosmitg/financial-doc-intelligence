cat > .gitignore << 'EOF'
# Environment
.env
.env.local

# Python
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Type checking cache
.mypy_cache/

# Storage — regenerated at runtime
storage/

# Data — keep txt sample docs, exclude large PDFs
data/documents/*.pdf

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Debug and test scripts
debug_*.py
test_chain.py

# HuggingFace model cache
.cache/

# Extra requirements file
requirements.top-level.txt
EOF.mypy_cache/
